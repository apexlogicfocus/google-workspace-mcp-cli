{
  "name": "@thenavidm/google-workspace-mcp-cli",
  "version": "0.2.1",
  "description": "Google Workspace MCP server and CLI for Claude Code, Codex and AI agents. 38 tools for Gmail, Drive, Sheets, Docs, Slides, Calendar, Tasks, Forms and Contacts through Google's official Workspace CLI, so your credential never leaves your machine.",
  "type": "module",
  "bin": {
    "google-workspace-mcp": "dist/index.js",
    "google-workspace-cli": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "SKILL.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "google-workspace",
    "gmail",
    "google-drive",
    "claude",
    "claude-code",
    "ai-agents",
    "cli",
    "command-line-tool"
  ],
  "author": {
    "name": "Navid Moazzez",
    "url": "https://navid.me"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenavidm/google-workspace-mcp-cli.git"
  },
  "homepage": "https://github.com/thenavidm/google-workspace-mcp-cli",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/express": "^5.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
